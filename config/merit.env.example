# Server-only settings. These must never receive a VITE_ prefix or enter a
# browser bundle. Keep disabled until provider wiring, database and webhook
# readiness are verified; enable only for authorized activation. An owner-run
# payment test remains the final acceptance step.
MERIT_ENABLED=false
ATTESTLY_API_KEY=
ATTESTLY_WEBHOOK_SECRET=
# Optional account pin. When blank, authenticated Merit configuration supplies it.
MERIT_STRIPE_ACCOUNT=
MERIT_MODE=

# An editable version and source/effective date accompany each pricing rule.
# Customer surcharge and merchant processing expense are different amounts.
MERIT_RULE_VERSION=
MERIT_CARD_SURCHARGE_BPS=
MERIT_CARD_SURCHARGE_SOURCE=
MERIT_CARD_SURCHARGE_EFFECTIVE_AT=

# Optional. Blank means unknown; it does not mean a zero processing expense.
# A configured percentage is a reported rate, not actual settlement evidence.
MERIT_PROCESSOR_FEE_BPS=
MERIT_PROCESSOR_FEE_SOURCE=
MERIT_PROCESSOR_FEE_EFFECTIVE_AT=
# Optional only after the fee basis is confirmed. Supported: charged_amount.
# Leave empty while unknown; an unsupported value also leaves estimates unknown.
MERIT_PROCESSOR_FEE_BASIS=

# Private, versioned referral rules. Leave absent until the operator has confirmed
# the code roster and terms. New/unknown codes fail closed; this is never VITE_*.
# JSON keys: version, source, status, unit="basis_points", currency="USD",
# effectiveFrom (ISO time), effectiveUntil (ISO time or null),
# firstOrderDiscountBps, commissionBps, approvedCodes (uppercase code array).
# The exact rule and commission used are frozen with each private payment attempt.
MERIT_AFFILIATE_RULES_JSON=
