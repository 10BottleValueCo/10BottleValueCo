# Browser Supabase settings are public; never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Enable only after the production Magic Link template contains {{ .Token }},
# the configured code length is six, and delivery/verification have been tested.
# When true, email code is the default for registration and sign-in.
VITE_AUTH_EMAIL_CODE_ENABLED=false

# These are release switches, not provider credentials. Configure each provider
# in Supabase first and allow the exact <site-origin>/?auth_return=1 redirect.
# Provider secrets belong only in Supabase, never in VITE_* variables.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false
