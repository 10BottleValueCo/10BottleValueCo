# Copy outside the bundle, fill in, keep private (it holds the database password).
TBV_ROOT=/srv/10bottlevalue
TBV_SITE_URL=https://store.example
TBV_MODE=staging
TBV_ADMIN_EMAIL=admin@example.com
TBV_STORE_EMAIL=support@10bottlevalue.co
DB_NAME=tbv_store
DB_USER=tbv_store
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
# Optional: host:port used for checks run on the server itself
TBV_LOOPBACK_HOST=
